# =============================================================================
# Vera Hiring Tracker — Variables para docker-compose
# Copia este archivo como .env (mismo directorio) y rellena los valores reales.
# =============================================================================

# Nombre del proyecto Compose (prefijo de contenedores y red).
# Sin esto, compose usa el nombre de la carpeta ("docker") y ves contenedores docker-*.
COMPOSE_PROJECT_NAME=vera-hiring-tracker-cursor

# ---- DOMINIO ----------------------------------------------------------------
# Dominio público apuntando por DNS a este servidor (puertos 80 y 443 abiertos).
# Caddy obtendrá automáticamente certificados HTTPS de Let's Encrypt.
DOMAIN=vera.tudominio.com

# ---- BASE DE DATOS ----------------------------------------------------------
POSTGRES_USER=vera
POSTGRES_PASSWORD=cambia_esto_por_una_password_fuerte
POSTGRES_DB=vera_hiring

# ---- CLERK ------------------------------------------------------------------
# Obtén estas claves en https://dashboard.clerk.com → tu app → API Keys
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# Secret aleatorio para firmar cookies. Generar con:
#   openssl rand -hex 32
SESSION_SECRET=reemplaza_por_64_caracteres_aleatorios_hex

# ---- LOGGING ----------------------------------------------------------------
LOG_LEVEL=info

# ---- OPCIONALES (puedes dejarlas vacías) ------------------------------------

# Notificaciones por email (Resend). Si vacío, no se envían emails.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=hiring@tudominio.com

# Análisis de CV con OpenAI. Si vacío, /analyze-cv falla pero el resto funciona.
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
CV_STORAGE_PROVIDER=local
LOCAL_CV_STORAGE_DIR=/app/uploads
CV_OCR_FALLBACK_ENABLED=true
CV_OCR_MIN_TEXT_LENGTH=40
CV_OCR_TIMEOUT_MS=30000
CV_OCR_LANG=eng
CV_OCR_MAX_PAGES=5

# Google Sheets — fuera de Replit no se conecta; el código usa el CSV en su lugar.
# Estas variables se ignoran sin el conector de Replit.
ALLOWED_EMAILS_SHEET_ID=
ALLOWED_EMAILS_SHEET_NAME=lista de alumnos
ALLOWED_EMAILS_COLUMN_HEADER=email

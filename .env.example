# =============================================================================
# Vera Hiring Tracker — Plantilla de variables de entorno
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA subas el .env real al repo (ya está en .gitignore por defecto).
# =============================================================================

# ---- OBLIGATORIAS ----------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/vera_hiring

# Puertos (uno por servicio)
PORT=8080                    # api-server
# El frontend (Vite) usa otro PORT; en Docker se sirve estático con nginx

# Frontend Vite — base path donde se monta la app (normalmente "/")
BASE_PATH=/

# Clerk — Auth
CLERK_SECRET_KEY=sk_test_your_clerk_secret_here
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_here

# Secret aleatorio para firmar cookies de sesión
# Generar con: openssl rand -hex 32
SESSION_SECRET=replace_with_random_64_char_hex_string

# ---- OPCIONALES (con efecto si están definidas) ----------------------------

# Modo del runtime
NODE_ENV=development         # production en deploy
LOG_LEVEL=info               # debug, info, warn, error

# Resend — Notificaciones por email (si vacío, no se envían emails)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=hiring@vera.example.com

# OpenAI — Análisis de CV (si vacío, /analyze-cv falla)
OPENAI_API_KEY=

# Allowlist de Google Sheets (sólo aplica si tienes credenciales del conector)
ALLOWED_EMAILS_SHEET_ID=1V_IHJn3ZAyVMdJo9oX3skYt2xunid37naSRN3_L2ohs
ALLOWED_EMAILS_SHEET_NAME=lista de alumnos
ALLOWED_EMAILS_COLUMN_HEADER=email
# Si no usas Google Sheets, deja un CSV en:
#   artifacts/api-server/data/allowed-emails.csv
# (formato: header "email" + un email por línea)

# Object Storage (S3, GCS, MinIO, etc.)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Clerk Frontend Proxy (sólo si usas dominio propio sin CNAME)
VITE_CLERK_PROXY_URL=
